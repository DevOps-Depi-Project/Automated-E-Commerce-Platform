# Environment secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Temporary and swap files
*.swp
*.swo
*~

# Dependencies
node_modules/
**/node_modules/

# Logs
*.log
npm-debug.log*

# Build outputs
dist/
build/
coverage/

# OS files
.DS_Store
Thumbs.db

# Temporarily excluded from GitHub
/.devcontainer/
/.github/workflows/
/k8s/
/kubectl-demo.ps1
/terraform-demo.ps1

# Throwaway secrets generated by the CI pipeline
ci.env

# Terraform: state can contain sensitive data; providers are re-downloaded by "terraform init"
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!*.tfvars.example
tfplan

# Ansible inventory generated by Terraform (contains the server IP)
ansible/inventory/hosts.ini
