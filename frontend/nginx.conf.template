# Nginx serves the storefront and acts as the reverse proxy (API gateway) for the
# backend services. The browser only talks to this server (port 3000 on the host):
#
#   /api/<service>/<path>  ->  http://<service-host>:<port>/<path>
#
# Payment Service is internal-only and is intentionally not routed.
#
# This is a template: the nginx image fills in ${NGINX_RESOLVER} and ${API_DOMAIN_SUFFIX}
# at start-up (see frontend/Dockerfile).
#   Docker Compose: resolver 127.0.0.11 (Docker DNS), short service names
#   Kubernetes:     resolver kube-dns.kube-system.svc.cluster.local and
#                   suffix .<namespace>.svc.cluster.local (nginx does not use DNS search domains)

map $api_service $api_backend {
    auth       authentication-service${API_DOMAIN_SUFFIX}:3003;
    product    product-service${API_DOMAIN_SUFFIX}:3001;
    cart       cart-service${API_DOMAIN_SUFFIX}:3006;
    inventory  inventory-service${API_DOMAIN_SUFFIX}:3004;
    order      order-service${API_DOMAIN_SUFFIX}:3002;
    search     search-service${API_DOMAIN_SUFFIX}:3007;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Resolving per request lets Nginx start (and recover) even when a backend is down
    # or has been recreated with a new IP.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    # Fail fast (JSON 503) when a stopped container's name no longer resolves.
    resolver_timeout 2s;

    client_max_body_size 64k;

    # Prometheus metrics are internal: Prometheus scrapes <service>:<port>/metrics directly
    # inside the network, so the public gateway must not expose them. (Regex locations are
    # checked in order, so this one has to stay above the API route.)
    location ~ ^/api/[^/]+/metrics/?$ {
        default_type application/json;
        return 404 '{"error":{"code":"NOT_FOUND","message":"Unknown API route"}}';
    }

    location ~ ^/api/(?<api_service>auth|product|cart|inventory|order|search)(?<api_path>/.*)$ {
        proxy_pass http://$api_backend$api_path$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;

        # Nginx's own 502/504 pages are HTML; return the same JSON error shape as the services.
        error_page 502 503 504 = @api_unavailable;
    }

    location @api_unavailable {
        default_type application/json;
        return 503 '{"error":{"code":"SERVICE_UNAVAILABLE","message":"The requested service is temporarily unavailable"}}';
    }

    location /api/ {
        default_type application/json;
        return 404 '{"error":{"code":"NOT_FOUND","message":"Unknown API route"}}';
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
