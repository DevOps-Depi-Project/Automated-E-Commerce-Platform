# Copy to .env and replace the placeholder values before using Docker Compose.
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ecommerce
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
INTERNAL_SERVICE_TOKEN=replace-with-a-random-internal-token-of-at-least-32-characters
RESERVATION_TTL_SECONDS=900
PAYMENT_SERVICE_URL=http://payment-service:3005/internal/payments
PAYMENT_SIMULATION_ENABLED=false
PAYMENT_DEFAULT_RESULT=success
PRODUCT_SERVICE_URL=http://product-service:3001

# Optional: set these to run `npm run seed:admin` in Authentication Service.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Demo Admin
