# Copy to jenkins/.env (ignored by Git) and fill in. Read by "docker compose" in this folder.

# Host port for the Jenkins web UI (http://localhost:8090). 8080 is often taken by other software.
JENKINS_PORT=8090

# Login for the Jenkins web UI.
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=choose-a-strong-password

# Docker Hub account and a Personal Access Token with Read & Write scope
# (hub.docker.com -> Account settings -> Personal access tokens). Not your password.
DOCKERHUB_USER=your-dockerhub-username
DOCKERHUB_TOKEN=

# Repository that Jenkins builds.
GIT_REPO_URL=https://github.com/DevOps-Depi-Project/Automated-E-Commerce-Platform.git

# Group id of /var/run/docker.sock: 0 on Docker Desktop; on Linux run: stat -c %g /var/run/docker.sock
DOCKER_SOCKET_GID=0
